# MongoDB Connection (use 127.0.0.1 locally or MongoDB Atlas M0 URI in production)
MONGODB_URI=mongodb://127.0.0.1:27017/swm_person1

# JWT Authentication
JWT_SECRET=replace-with-strong-32-char-secret
JWT_EXPIRES_IN=7d

# Google Gemini API (Server-side only — never expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Local Express Dev Server Port
PORT=4001
CORS_ORIGIN=http://localhost:5171
