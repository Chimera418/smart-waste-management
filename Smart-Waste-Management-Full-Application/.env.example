# MongoDB Atlas M0 URI or local 127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/swm_full

# Authentication
JWT_SECRET=replace-with-strong-32-char-secret
JWT_EXPIRES_IN=7d

# Google Gemini API (Server-side only — never expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Vercel Cron Secret
CRON_SECRET=replace-with-cron-secret

# Real Email Notifications via Resend API (Free tier: 3,000 emails/mo)
RESEND_API_KEY=
RESEND_FROM=CivicClean SWM <onboarding@resend.dev>

# Optional Nodemailer SMTP Fallback (Gmail App Password or Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@civicclean.local

# Optional Firebase Realtime Database Free Spark Tier Push
FIREBASE_DATABASE_URL=

# Optional CARTO Basemaps API Key (Frontend tile layer)
VITE_CARTO_API_KEY=

# Local Development
PORT=4000
CORS_ORIGIN=http://localhost:5170
